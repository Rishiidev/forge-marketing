# Node
node_modules/
npm-debug.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Local file-backed dev store (lib/file-store.ts) — leads/referrals/reviews
# written by the console CRM provider when no real CRM is configured.
# Contains lead PII in local dev; never commit.
.data/

# Env
.env
.env.local
.env.*.local

# Logs
*.log

# Client work output — generated site previews, GBP-scraped JSON, customer
# research, brand reference assets. NEVER push this directory to the public
# repo. It contains named business details (phone, address, hours, reviews).
audits/

# Working scratch files created during design / dev sessions.
# Hidden by convention; do not commit.
.gitignore.append
.logo_compare.png
.nav_preview_4x.png
.vercel

# Secrets / credentials — never commit real values.
# Copy .env.local.example to .env.local and fill in real values locally.
*.pem
*.key
*.p12
*.crt
*.cer
id_rsa*
id_ed25519*
*credentials*.json
*serviceAccount*.json
